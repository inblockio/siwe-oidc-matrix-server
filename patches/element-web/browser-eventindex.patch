+        if (checkpoint) await this.addCrawlerCheckpoint(checkpoint);
+        return allAlready;
+    }
+
+    /**
+     * Record a crawler position; see {@link BaseEventIndexManager.addCrawlerCheckpoint}. Idempotent by tuple: the
