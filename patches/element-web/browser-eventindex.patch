+        expect(bounds).toEqual({
+            tier: "desktop",
+            hotWindowBytes: 128 * 1024 * 1024,
+            diskBudgetBytes: 512 * 1024 * 1024,
+            manifestCeilingBytes: 700_000 * 157,
